{
  "name": "openspec-verify-loop",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Native OpenCode plugin that verifies and fixes an OpenSpec change until clean",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run bundle && npm test && node scripts/validate-plugin.mjs"
  },
  "dependencies": {
    "@opencode/client": "2.2.5",
    "@opencode/plugin": "2.2.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.16.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills/openspec-verify-loop",
    "LICENSE"
  ]
}
